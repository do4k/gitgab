{
  "AppSettings": {
    "LogLevel": "Debug",
    "RepoCacheDir": "./cache/repos",
    "DefaultTimeWindow": "P1D"
  },
  "Repositories": [
    {
      "Name": "test-repo",
      "Url": "https://github.com/do4k/test-repo.git",
      "Branch": "main",
      "Auth": {
        "Type": "https"
      },
      "TimeWindow": "P1D"
    }
  ],
  "LLM": {
    "Provider": "gemini",
    "Model": "gemini-2.5-flash",
    "Temperature": 0.7,
    "MaxTokens": 2048,
    "TimeoutSeconds": 30
  },
  "Connectors": [
    {
      "Type": "console",
      "Name": "console-output"
    },
    {
      "Type": "file",
      "Name": "dev-file-output",
      "Path": "./output/{{repo.name}}-{{date:yyyy-MM-dd}}.md"
    }
  ],
  "Schedule": {
    "Enabled": false
  }
}
